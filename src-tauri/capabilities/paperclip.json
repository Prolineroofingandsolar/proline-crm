{
  "identifier": "paperclip-capability",
  "description": "Lets the Virtual Office talk to a Paperclip server on this Mac or the user's Tailscale network",
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:*/*" },
        { "url": "http://127.0.0.1:*/*" },
        { "url": "http://*.ts.net:*/*" },
        { "url": "https://*.ts.net/*" }
      ]
    }
  ]
}
