# Copy to ~/.config/proline/paperclip-bridge.env and keep the real file private.
PAPERCLIP_BASE_URL=http://127.0.0.1:3100
PAPERCLIP_COMPANY_ID=your-paperclip-company-id
PAPERCLIP_ORGANISATION_ID=your-proline-organisation-id
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-supabase-anon-key
PAPERCLIP_BRIDGE_TOKEN=generate-a-long-random-secret
PAPERCLIP_BRIDGE_INTERVAL_MS=15000

# Only needed when Paperclip is running in authenticated mode.
# PAPERCLIP_API_TOKEN=your-private-paperclip-token
